# ─────────────────────────────────────────────────────────────
# Georgio Agent — contoh konfigurasi environment
# Salin ke .env.local bila perlu. JANGAN pernah commit .env.local
# ─────────────────────────────────────────────────────────────

# 1) Agent server (opsional)
# URL publik agent setelah di-deploy (tanpa trailing slash).
# Kosongkan = frontend memakai AI gratis di browser + fallback offline.
VITE_AGENT_URL=

# 2) CloudBase — wajib untuk login & Memory Graph
# EnvId DITUBAHKAN lewat Manage AppAuth / dashboard.
# Format: <nama>-<hash> — ambil dari queryEnv(action="list") atau dashboard.
VITE_CLOUDBASE_ENV_ID=

# 3) Access Key (opsional tapi disarankan)
# Publishable key saja (bukan secret key). Disediakan dashboard → App → Basic Info.
# JANGAN gunakan secret key di sini — akan terekspos di bundle browser.
VITE_CLOUDBASE_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# KEAMANAN — tidak boleh ada di .env manapun:
#   • SecretKey / SecretId (server-side only)
#   • Access token CloudBase (dikelola SDK, jangan disimpan manual)
#   • Password user (dikelola CloudBase Auth)
# ─────────────────────────────────────────────────────────────