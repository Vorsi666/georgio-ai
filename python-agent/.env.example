# Environment variables for Georgio AI Python Agent
# 
# To use Pollinations AI (current default):
# OPENAI_API_KEY=your_pollinations_key_here  # Often not required for Pollinations
# OPENAI_API_BASE=https://text.pollinations.ai/openai/v1
# MODEL_NAME=openai-chat
#
# To use Alibaba Cloud Qwen (BaiLian):
# OPENAI_API_KEY=your_bailian_api_key_here
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-turbo  # or qwen-plus, qwen-max, etc.
#
# To use other OpenAI-compatible APIs, adjust accordingly.
# 
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://text.pollinations.ai/openai/v1
MODEL_NAME=openai-chat
# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=georgio-ai-agent